<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<Project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="project_projx.xsd">

  <SchemaVersion>2.1</SchemaVersion>

  <Header>### uVision Project, (C) Keil Software</Header>

  <Targets>
    <Target>
      <TargetName>M0G3519_nortos_keil</TargetName>
      <ToolsetNumber>0x4</ToolsetNumber>
      <ToolsetName>ARM-ADS</ToolsetName>
      <pCCUsed>6160000::V6.16::ARMCLANG</pCCUsed>
      <uAC6>1</uAC6>
      <TargetOption>
        <TargetCommonOption>
          <Device>MSPM0G3519</Device>
          <Vendor>Texas Instruments</Vendor>
          <OutputDirectory>.\Objects\</OutputDirectory>
          <OutputName>M0G3519_nortos_keil</OutputName>
          <CreateHexFile>1</CreateHexFile>
          <BrowseInformation>1</BrowseInformation>
          <BeforeMake>
            <RunUserProg1>1</RunUserProg1>
            <UserProg1Name>cmd.exe /C "$Psyscfg.bat '$P' M0G3519.syscfg"</UserProg1Name>
          </BeforeMake>
        </TargetCommonOption>
        <DllOption>
          <SimDllName>SARMCM3.DLL</SimDllName>
          <SimDllArguments>-MPU</SimDllArguments>
          <SimDlgDll>DARMCM1.DLL</SimDlgDll>
          <SimDlgDllArguments>-pCM0+</SimDlgDllArguments>
          <TargetDllName>SARMCM3.DLL</TargetDllName>
          <TargetDllArguments>-MPU</TargetDllArguments>
          <TargetDlgDll>TARMCM1.DLL</TargetDlgDll>
          <TargetDlgDllArguments>-pCM0+</TargetDlgDllArguments>
        </DllOption>
        <Utilities>
          <Flash1>
            <UseTargetDll>1</UseTargetDll>
            <UseExternalTool>0</UseExternalTool>
            <RunIndependent>0</RunIndependent>
            <UpdateFlashBeforeDebugging>1</UpdateFlashBeforeDebugging>
            <Capability>1</Capability>
          </Flash1>
        </Utilities>
        <TargetArmAds>
          <ArmAdsMisc>
            <AdsCpuType>"Cortex-M0+"</AdsCpuType>
          </ArmAdsMisc>
          <Cads>
            <Optim>3</Optim>
            <wLevel>4</wLevel>
            <v6Lang>3</v6Lang>
            <v6LangP>3</v6LangP>
            <VariousControls>
              <MiscControls></MiscControls>
              <Define>__MSPM0G3519__</Define>
              <Undefine></Undefine>
              <IncludePath>../,../src,../src/app,../src/middle,../src/hardware,../src/MSPM0G3519_Library/zf_common,../src/MSPM0G3519_Library/zf_driver,../../../../../../source/third_party/CMSIS/Core/Include,../../../../../../source</IncludePath>
            </VariousControls>
          </Cads>
          <LDads>
            <umfTarg>0</umfTarg>
            <Ropi>0</Ropi>
            <Rwpi>0</Rwpi>
            <noStLib>0</noStLib>
            <RepFail>1</RepFail>
            <useFile>0</useFile>
            <ScatterFile>./mspm0g3519.sct</ScatterFile>
            <Misc>../../../../../../source/ti/driverlib/lib/keil/m0p/mspm0gx51x/driverlib.a</Misc>
          </LDads>
        </TargetArmAds>
      </TargetOption>
      <Groups>
        <Group>
          <GroupName>Source</GroupName>
